  "history": [
    {
      "years": "1990",
      "title": "Solar Eagle",
      "tag": "Solar car",
      "text": "Cal State LA's first solar car. 4th of 29 at GM Sunrayce USA, then top ten at the World Solar Challenge in Australia.",
      "photos": []
    },
    {
      "years": "1993",
      "title": "Solar Eagle II",
      "tag": "Solar car",
      "text": "Fastest qualifier, so it started from pole. 3rd of 34 at Sunrayce 93, Dallas to Minneapolis.",
      "photos": []
    },
    {
      "years": "1997",
      "title": "Solar Eagle III wins Sunrayce 97",
      "tag": "Solar car · 1st place",
      "win": true,
      "text": "First place over 1,230 miles at a record 43.29 mph average, with no breakdowns, finishing about 20 minutes ahead of MIT.",
      "photos": [
        [
          "img/history/solar-eagle-iii-team.jpg",
          "The Solar Eagle III team with the car"
        ],
        [
          "img/history/solar-eagle-iii.jpg",
          "Solar Eagle III on the course"
        ]
      ]
    },
    {
      "years": "2011–2014",
      "title": "EcoCAR 2",
      "tag": "Hybrid · GM + DOE",
      "text": "Turned a 2013 Chevrolet Malibu into a hybrid. 2nd overall in Year 2, plus the Most Improved Team award.",
      "photos": []
    },
    {
      "years": "2014–2018",
      "title": "EcoCAR 3",
      "tag": "Hybrid · GM + DOE",
      "text": "Hybridized a Chevrolet Camaro alongside 15 other universities. Won the 2018 Clean Air Award from South Coast AQMD for teaching the public about efficient vehicles.",
      "photos": [
        [
          "img/history/ecocar3-clean-air-award.jpg",

        [
          "img/history/ecocar3-camaro.jpg",
          "The EcoCAR 3 Camaro with the team"
        ]
      ]
    },
    {
      "years": "2023–2026",
      "title": "Battery Workforce Challenge",
      "tag": "Battery · DOE + Stellantis",
      "win": true,
      "text": "One of 12 schools, teamed with Cerritos College. Built battery hardware for a 2024 RAM ProMaster EV: a 4s5p module in Year 2, a 12s31p module of 372 cells in Year 3, and a Battery Disconnect Unit. 1st place in BDU performance testing (26.5 of 27) and 1st place Manufacturability Award.",
      "photos": [
